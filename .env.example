# DAKSH P3 Aadhaar Module - Environment Configuration
APP_NAME=DAKSH Aadhaar Screening
MODULE=P3_AADHAAR
MODULE_VERSION=1.0.0
SCHEMA_VERSION=1.0
ENVIRONMENT=development
PORT=8000

# Storage
STORAGE_MODE=HASH_ONLY
ARTIFACTS_DIR=./data/artifacts
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=5
MAX_ZIP_SIZE_MB=5
MAX_ZIP_FILES=20

# Database (optional)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=daksh_aadhaar

# Security
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# OCR
OCR_ENGINE=rapidocr
OCR_FALLBACK_ENABLED=true

# Face
FACE_MODEL=SFace
FACE_THRESHOLD=0.6

# Audit
AUDIT_CHAIN_FILE=./data/audit_chain.jsonl

# Blockchain (optional - leave empty for local chain)
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=

# QR Signature (optional)
UIDAI_QR_CERT_PATH=
